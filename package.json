{
  "name": "colophon-archive",
  "version": "0.0.1",
  "description": "Where colophons are written, tested and kept",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "emulator:build": "node tools/build_emulator.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prettier:check": "npx prettier . --check",
    "prettier:write": "npx prettier . --write",
    "lint": "eslint 'generator/**/*.js' 'src/**/*.js' 'e2e/**/*.js' 'tools/**/*.js' 'vite.config.js' 'playwright.config.js' 'eslint.config.js' 'vitest.config.js'",
    "check": "npm run prettier:check && npm run lint && npm test"
  },
  "author": "tulinmola",
  "license": "MIT",
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
